# Exact versions only. The stack table in ARCHITECTURE-SPINE.md is pinned, and a
# `^`/`~` range would let a transitive bump silently move it.
save-exact=true

# Refuse to install under a Node that does not satisfy engines.node.
engine-strict=true

# Third (free) enforcement layer for AD-1: pnpm's isolated node_modules means
# packages/domain physically cannot resolve `pg` just because packages/db
# installed it. Never set node-linker=hoisted or shamefully-hoist here.
node-linker=isolated
