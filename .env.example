# StuWith — every environment variable the stack requires.
#
# AD-14: values are validated once at startup and the process exits non-zero,
# naming the exact missing variable, before it opens a port. NOTHING here has a
# default in code — that is the point. Copy to `.env` and fill in.
#
# `.env` is git-ignored; only this file is tracked. Never paste a real secret here.
#
#   cp .env.example .env
#   docker compose --env-file .env -f infra/docker-compose.yml up -d --wait
#
# `--env-file` is not optional: Compose looks for `.env` beside the compose file
# (infra/), not at the repo root.

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
APP_VERSION=0.1.0

# ── Process ports (must differ — the two processes run separately) ───────────
API_PORT=3001
GATEWAY_PORT=3002

# ── PostgreSQL 18 + pgvector ─────────────────────────────────────────────────
# Superuser/owner. Used by `docker compose` to initialise the cluster and by
# `pnpm --filter @stuwith/db migrate` to run migrations. NOT used by either app.
POSTGRES_USER=stuwith_owner
POSTGRES_PASSWORD=
POSTGRES_DB=stuwith
POSTGRES_PORT=5432
MIGRATION_DATABASE_URL=

# AD-8: one login role per process, so write ownership is enforced by GRANT.
# These two passwords are consumed by the roles migration.
DB_ROLE_API_PASSWORD=
DB_ROLE_REALTIME_PASSWORD=

# Connection strings the two processes actually use. api connects as
# `stuwith_api`, realtime-gateway as `stuwith_realtime` — never as the owner.
API_DATABASE_URL=
REALTIME_DATABASE_URL=

# ── Valkey 9.0.4 (BSD-3; replaces Redis) ─────────────────────────────────────
VALKEY_PORT=6379
VALKEY_URL=

# How long one Valkey command may take before apps/api treats it as an outage.
# See the rate-limiting block below for why it is this small. Default 250.
#VALKEY_COMMAND_TIMEOUT_MS=250

# ── LiveKit 1.13.5 ───────────────────────────────────────────────────────────
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_PORT=7880
LIVEKIT_RTC_TCP_PORT=7881
LIVEKIT_UDP_PORT_START=50000
LIVEKIT_UDP_PORT_END=50019

# ── coturn 4.17.2 (mandatory — WebRTC over the public internet needs TURN) ────
TURN_REALM=
TURN_SECRET=
# Public IP of the VPS. Use 127.0.0.1 for local development.
TURN_EXTERNAL_IP=127.0.0.1
TURN_PORT=3478
TURN_RELAY_PORT_START=50100
TURN_RELAY_PORT_END=50119

# ── Web session ──────────────────────────────────────────────────────────────
# httpOnly + secure session cookie signing key. At least 32 characters.
# Also the HMAC key session/refresh tokens are hashed with before storage, so a
# database dump on its own cannot be replayed as a cookie. Rotating it logs
# everybody out, which is the intended behaviour.
SESSION_COOKIE_SECRET=

# Where a completed login sends the browser, and the public origin of apps/api
# that `redirect_uri` is built from. No trailing slash: several providers report a
# doubled slash as a redirect_uri mismatch with no useful message.
WEB_BASE_URL=http://localhost:3000
OAUTH_REDIRECT_BASE_URL=http://localhost:3001

# Read by apps/web in the BROWSER. An origin, not a secret.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Session lifetimes, in seconds. Operational knobs, not secrets, so they have
# defaults in code; set them here to override.
#   SESSION_TTL_SECONDS          default 3600     (1 hour)
#   SESSION_REFRESH_TTL_SECONDS  default 2592000  (30 days, rotated on every use)
#   OAUTH_STATE_TTL_SECONDS      default 600      (10 minutes at the consent screen)
SESSION_TTL_SECONDS=3600
SESSION_REFRESH_TTL_SECONDS=2592000
OAUTH_STATE_TTL_SECONDS=600

# ── Rate limiting on /v1/auth/* (Story 1.3 part 2) ───────────────────────────
#
# REQUIRED, and DELIBERATELY LEFT UNSET BELOW. apps/api exits non-zero naming
# this variable until somebody decides, because every value it could ship with
# is the wrong one for half of all deployments — and both mistakes are silent.
#
# Comma-separated addresses and CIDRs of the reverse proxies that sit in FRONT
# of apps/api, or the single word `none`:
#
#   none        nothing in front (a laptop, `pnpm dev`, a bare box).
#               X-Forwarded-For is ignored entirely and the socket address is
#               the client. It is a decision, not an absence — an EMPTY value
#               is refused, because a half-finished edit must not mean this.
#   10.0.0.2    one Caddy terminating TLS in front, addressed on the Docker
#               network. Use the address apps/api actually sees, not the public
#               one, and a CIDR (10.0.0.0/24) if it moves.
#
# Declare too FEW and every visitor is counted as the proxy, so the first person
# to trip the limit locks out the whole product. Declare a proxy that is not
# really in front and anybody connecting directly can forge X-Forwarded-For and
# pick their own rate-limit key. Both look healthy and both pass CI.
#
# X-Forwarded-For is read ONLY when the socket peer is one of these addresses.
# Hop counting was tried and removed: it cannot check who the immediate peer is,
# which is why fastify@5.12.1 dropped numeric trustProxy as a security fix.
#TRUSTED_PROXY_ADDRESSES=

# Limits and windows. Operational knobs, not secrets, so they have defaults in
# code; UNCOMMENT one here only to override it.
#
# Every MAX is the number ALLOWED: the request after it is the one refused, and
# the failure after RATE_LIMIT_BRUTE_FORCE_MAX is the one that locks.
#   RATE_LIMIT_IP_MAX                    default 30   attempts per address
#   RATE_LIMIT_IP_WINDOW_SECONDS         default 60
#   RATE_LIMIT_USER_MAX                  default 10   attempts per credential
#   RATE_LIMIT_USER_WINDOW_SECONDS       default 60
#   RATE_LIMIT_BRUTE_FORCE_MAX           default 5    consecutive failures ALLOWED
#   RATE_LIMIT_BRUTE_FORCE_LOCK_SECONDS  default 900  (15 minutes)
#
# VALKEY_COMMAND_TIMEOUT_MS (above) belongs to this layer too, and is small on
# purpose: the layer FAILS OPEN, so a slow Valkey ends with the request going
# through anyway and every millisecond of waiting is added to a login that was
# always going to succeed.
# Commented out for the same reason the file gives above: a copied `.env` that
# sets them pins today's defaults for ever, so raising a default in code would
# never reach any deployment that started from this file.
#RATE_LIMIT_IP_MAX=30
#RATE_LIMIT_IP_WINDOW_SECONDS=60
#RATE_LIMIT_USER_MAX=10
#RATE_LIMIT_USER_WINDOW_SECONDS=60
#RATE_LIMIT_BRUTE_FORCE_MAX=5
#RATE_LIMIT_BRUTE_FORCE_LOCK_SECONDS=900

# ── OAuth providers (Story 1.2) ──────────────────────────────────────────────
#
# Comma-separated list of the providers this deployment offers. Allowed values:
# google, facebook, apple, microsoft. EMPTY BY DEFAULT — a provider that is not
# listed answers 404 and needs no credential.
#
# A provider that IS listed must be configured completely: apps/api exits
# non-zero, naming the exact missing variable, BEFORE it opens its port (AD-14).
# There is no "half configured" state and no default for any value below.
#
# No real credential is committed anywhere in this repo. Fill these in `.env`.
AUTH_ENABLED_PROVIDERS=

# Google Cloud console -> Credentials -> OAuth 2.0 Client ID (Web application).
# Authorised redirect URI: ${OAUTH_REDIRECT_BASE_URL}/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Meta for Developers -> App -> Facebook Login.
# Valid OAuth Redirect URI: ${OAUTH_REDIRECT_BASE_URL}/v1/auth/facebook/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Microsoft Entra ID app registration.
# MICROSOFT_TENANT_ID selects the authority and therefore WHO can sign in:
#   common        - any Microsoft account, personal included
#   organizations - any work or school account
#   <tenant GUID> - exactly one organisation (what a Campus customer buys)
# Redirect URI: ${OAUTH_REDIRECT_BASE_URL}/v1/auth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# Sign in with Apple. Apple issues no static client secret: the server signs a
# short-lived ES256 JWT with the .p8 key, so all four values are required.
# APPLE_CLIENT_ID is the Services ID, not the bundle id.
# APPLE_PRIVATE_KEY is the PKCS#8 PEM from AuthKey_XXXXXXXXXX.p8; its newlines may
# be written as the two characters backslash-n so the whole key fits on one line.
# Return URL: ${OAUTH_REDIRECT_BASE_URL}/v1/auth/apple/callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
