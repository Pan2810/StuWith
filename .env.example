# StuWith — every environment variable the stack requires.
#
# AD-14: values are validated once at startup and the process exits non-zero,
# naming the exact missing variable, before it opens a port. NOTHING here has a
# default in code — that is the point. Copy to `.env` and fill in.
#
# `.env` is git-ignored; only this file is tracked. Never paste a real secret here.
#
#   cp .env.example .env
#   docker compose --env-file .env -f infra/docker-compose.yml up -d --wait
#
# `--env-file` is not optional: Compose looks for `.env` beside the compose file
# (infra/), not at the repo root.

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
APP_VERSION=0.1.0

# ── Process ports (must differ — the two processes run separately) ───────────
API_PORT=3001
GATEWAY_PORT=3002

# ── PostgreSQL 18 + pgvector ─────────────────────────────────────────────────
# Superuser/owner. Used by `docker compose` to initialise the cluster and by
# `pnpm --filter @stuwith/db migrate` to run migrations. NOT used by either app.
POSTGRES_USER=stuwith_owner
POSTGRES_PASSWORD=
POSTGRES_DB=stuwith
POSTGRES_PORT=5432
MIGRATION_DATABASE_URL=

# AD-8: one login role per process, so write ownership is enforced by GRANT.
# These two passwords are consumed by the roles migration.
DB_ROLE_API_PASSWORD=
DB_ROLE_REALTIME_PASSWORD=

# Connection strings the two processes actually use. api connects as
# `stuwith_api`, realtime-gateway as `stuwith_realtime` — never as the owner.
API_DATABASE_URL=
REALTIME_DATABASE_URL=

# ── Valkey 9.0.4 (BSD-3; replaces Redis) ─────────────────────────────────────
VALKEY_PORT=6379
VALKEY_URL=

# ── LiveKit 1.13.5 ───────────────────────────────────────────────────────────
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_PORT=7880
LIVEKIT_RTC_TCP_PORT=7881
LIVEKIT_UDP_PORT_START=50000
LIVEKIT_UDP_PORT_END=50019

# ── coturn 4.17.2 (mandatory — WebRTC over the public internet needs TURN) ────
TURN_REALM=
TURN_SECRET=
# Public IP of the VPS. Use 127.0.0.1 for local development.
TURN_EXTERNAL_IP=127.0.0.1
TURN_PORT=3478
TURN_RELAY_PORT_START=50100
TURN_RELAY_PORT_END=50119

# ── Web session ──────────────────────────────────────────────────────────────
# httpOnly + secure session cookie signing key. At least 32 characters.
SESSION_COOKIE_SECRET=
