# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
.next/
# The E2E build of apps/web. Separate from .next so `pnpm test:e2e` cannot
# overwrite the bundle a developer is running (see apps/web/next.config.ts).
.next-e2e/
out/
*.tsbuildinfo
.tsbuild/

# Test output
coverage/
test-results/
playwright-report/
blob-report/
.playwright/

# Env — only .env.example is tracked (AD-14: no secret ever enters git)
.env
.env.*
!.env.example

# Local infra state
infra/.data/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Scratch files written by tests/gates/ad-1-dependency-direction.test.ts. They are
# deliberately placed where their presence BREAKS the build, so a crashed run must
# never be able to leave one committable.
**/__ad1_violation__.ts

# The same arrangement for tests/gates/plan-capacity-exhaustive.test.ts. A separate
# name rather than a shared one: the two gates write into the same directory, and a
# leftover file has to say which test left it.
**/__plan_capacity_probe__.ts

# And for tests/gates/no-hard-delete-rooms.test.ts, which plants a probe in
# apps/api/src/rooms/. This one needs the ignore MORE than the two above, not less:
# their contents break the build, so a crashed run announces itself on the next
# command. This probe is valid TypeScript that merely trips the gate's own scan, so
# a leftover would typecheck, build, and sit in `git status` looking committable.
**/rooms-gate-probe.generated.ts
